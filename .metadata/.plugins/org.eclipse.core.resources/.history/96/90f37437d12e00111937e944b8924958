package simulator.view;

import java.awt.BorderLayout;
import java.awt.Dimension;
import java.io.File;
import java.io.FileInputStream;
import java.io.InputStream;
import javax.swing.Box;
import javax.swing.ImageIcon;
import javax.swing.JButton;
import javax.swing.JFileChooser;
import javax.swing.JLabel;
import javax.swing.JPanel;
import javax.swing.JSpinner;
import javax.swing.JTextField;
import javax.swing.JToolBar;
import javax.swing.SpinnerNumberModel;
import javax.swing.SwingUtilities;

import org.json.JSONObject;
import org.json.JSONTokener;

import simulator.control.Controller;

@SuppressWarnings("serial")
class ControlPanel extends JPanel {
	private Controller ctrl;
	private ChangeRegionsDialog changeRegionsDialog;
	
	private JToolBar toolBar;
	private JFileChooser fileChooser;
	private boolean stopped = true;
	
	// Botones
	private JButton openButton;
	private JButton viewerButton;
	private JButton regionsButton;
	private JButton runButton;
	private JButton stopButton;
	private JButton quitButton;
	
	// Controles numéricos
	private JSpinner stepSpinner;
	private JTextField dtField;

	public ControlPanel(Controller ctrl) {
		this.ctrl = ctrl;
		changeRegionsDialog = new ChangeRegionsDialog(ctrl);
		initGUI();
	}

	private void initGUI() {
		setLayout(new BorderLayout());
		toolBar = new JToolBar();
		add(toolBar, BorderLayout.PAGE_START);

		fileChooser = new JFileChooser();
		fileChooser.setCurrentDirectory(new File(System.getProperty("user.dir") + "/resources/examples"));
		initOpenButton();
		toolBar.addSeparator();
		
		initViewerButton();
		initRegionsButton();
		toolBar.addSeparator();

		// 5. Botón Run (Play)
		runButton = new JButton(new ImageIcon(ViewUtils.class.getResource("/icons/run.png")));
		runButton.setToolTipText("Ejecutar la simulación");
		runButton.addActionListener((e) -> {
			setButtonsEnabled(false);
			stopped = false;
			int steps = (Integer) stepsSpinner.getValue();
			double dt = Double.parseDouble(dtField.getText());
			runSim(steps, dt);
		});
		toolBar.add(runButton);

		// 6. Botón Stop
		stopButton = new JButton(new ImageIcon(ViewUtils.class.getResource("/icons/stop.png")));
		stopButton.setToolTipText("Detener la simulación");
		stopButton.setEnabled(false); // Por defecto deshabilitado hasta que empiece a correr
		stopButton.addActionListener((e) -> {
			stopped = true;
		});
		toolBar.add(stopButton);

		toolBar.addSeparator();

		// 7. Spinner de Pasos (Steps)
		toolBar.add(new JLabel(" Steps: "));
		stepsSpinner = new JSpinner(new SpinnerNumberModel(10000, 1, 100000, 100));
		stepsSpinner.setMaximumSize(new Dimension(80, 40));
		toolBar.add(stepsSpinner);

		// 8. Campo de Delta-Time (dt)
		toolBar.add(new JLabel(" Delta-Time: "));
		dtField = new JTextField("0.03", 5);
		dtField.setMaximumSize(new Dimension(80, 40));
		toolBar.add(dtField);

		// Relleno para enviar el botón de salida a la derecha
		toolBar.add(Box.createGlue());
		toolBar.addSeparator();

		// 9. Botón Salir (Exit)
		quitButton = new JButton(new ImageIcon(ViewUtils.class.getResource("/icons/exit.png")));
		quitButton.setToolTipText("Salir del Simulador");
		quitButton.addActionListener((e) -> {
			ViewUtils.quit(this);
		});
		toolBar.add(quitButton);
	}
	
	private void initOpenButton() {
		openButton = new JButton(new ImageIcon("resources/icons/open.png"));
		openButton.setToolTipText("Load an input file into the simulator");
		openButton.addActionListener(e -> {
			if (fileChooser.showOpenDialog(ViewUtils.getWindow(this)) == JFileChooser.APPROVE_OPTION) {
				JSONObject jo = new JSONObject(new JSONTokener((InputStream)new FileInputStream(fileChooser.getSelectedFile())));
				
				ctrl.reset(jo.getInt("cols"), jo.getInt("rows"), jo.getInt("width"), jo.getInt("height"));
				ctrl.loadData(jo);
			}
		});
		toolBar.add(openButton);
	}
	
	private void initViewerButton() {
		viewerButton = new JButton(new ImageIcon("resources/icons/viewer.png"));
		viewerButton.setToolTipText("Map Viewer");
		viewerButton.addActionListener(e -> new MapWindow(ViewUtils.getWindow(this), ctrl));
		toolBar.add(viewerButton);
	}
	
	private void initRegionsButton() {
		regionsButton = new JButton(new ImageIcon("resources/icons/regions.png"));
		regionsButton.setToolTipText("Change Regions");
		regionsButton.addActionListener(e -> changeRegionsDialog.open(ViewUtils.getWindow(this)));
		toolBar.add(regionsButton);
	}
	
	private void initRunButton() {
		runButton = new JButton(new ImageIcon("resources/icons/run.png"));
		runButton.setToolTipText("Run the simulator");
		runButton.addActionListener((e) -> { // POR LA NOCHE LO HE DEJADO AQUÍ
			setButtonsEnabled(false);
			stopped = false;
			int steps = (Integer) stepsSpinner.getValue();
			double dt = Double.parseDouble(dtField.getText());
			runSim(steps, dt);
		});
		toolBar.add(runButton);
	}

	/**
	 * Ejecuta la simulación de forma recursiva asíncrona usando SwingUtilities 
	 * para evitar bloquear el hilo del despachador de eventos (EDT).
	 */
	private void runSim(int n, double dt) {
		if (n > 0 && !stopped) {
			try {
				ctrl.advance(dt); 
				Thread.sleep(1); // Pequeña pausa para no saturar la CPU y permitir repintado rápido
				SwingUtilities.invokeLater(() -> run_sim(n - 1, dt));
			} catch (Exception e) {
				ViewUtils.showErrorMsg("Error durante la simulación: " + e.getMessage());
				setButtonsEnabled(true);
				stopped = true;
			}
		} else {
			// Cuando termina o se da a Stop, volvemos a habilitar botones
			setButtonsEnabled(true);
			stopped = true;
		}
	}

	/**
	 * Activa o desactiva los controles de la interfaz según el estado de la simulación.
	 */
	private void setButtonsEnabled(boolean enabled) {
		openButton.setEnabled(enabled);
		viewerButton.setEnabled(enabled);
		regionsButton.setEnabled(enabled);
		runButton.setEnabled(enabled);
		stepsSpinner.setEnabled(enabled);
		dtField.setEnabled(enabled);
		quitButton.setEnabled(enabled);
		
		// El botón de stop tiene el estado inverso
		stopButton.setEnabled(!enabled);
	}
}
